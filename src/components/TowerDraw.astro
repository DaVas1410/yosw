const STAGGER = 0.16;
const DRAW_DUR = 0.6;
---

<svg class="tower-draw" viewBox="375 55 210 495" role="img" aria-label={alt}>
  {shapes.map((s, i) => (
    <path
      class="tower-draw__outline"
      d={s.d}
      pathLength="1"
      stroke={s.fill}
      style={`animation-delay: ${(i * STAGGER).toFixed(2)}s`}
    />
  ))}
  {shapes.map((s, i) => (
    <path
      class="tower-draw__fill"
      d={s.d}
      fill={s.fill}
      style={`animation-delay: ${(i * STAGGER + DRAW_DUR * 0.7).toFixed(2)}s`}
    />
  ))}
</svg>
{caption && <p class="tower-draw__caption">{caption}</p>}

<style define:vars={{ drawDur: `${DRAW_DUR}s` }}>
  .tower-draw {
    width: 100%;
    max-width: 240px;
    height: auto;
    display: block;
  }
  .tower-draw__outline {
    fill: none;
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: tower-draw-line var(--drawDur) ease forwards;
  }
  .tower-draw__fill {
    opacity: 0;
    animation: tower-draw-fill 0.45s ease forwards;
  }
  @keyframes tower-draw-line {
    to { stroke-dashoffset: 0; }
  }
  @keyframes tower-draw-fill {
    to { opacity: 1; }
  }
  .tower-draw__caption {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-muted-2);
    letter-spacing: 0.05em;
    text-align: center;
    margin: 0.6rem 0 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .tower-draw__outline { animation: none; stroke-dashoffset: 0; opacity: 0; }
    .tower-draw__fill { animation: none; opacity: 1; }
  }
</style>
