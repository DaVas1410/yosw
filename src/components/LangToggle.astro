---
import type { Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const otherLang: Locale = lang === 'es' ? 'en' : 'es';
const currentPath = Astro.url.pathname;
const targetPath = currentPath.replace(/^\/(es|en)/, `/${otherLang}`);
---

<a class="lang-toggle" href={targetPath}>{otherLang.toUpperCase()}</a>

<style>
  .lang-toggle {
    font-family: var(--font-body);
    color: var(--color-text);
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--color-muted) 40%, transparent);
    border-radius: var(--radius);
    padding: calc(var(--space) / 2) var(--space);
    font-size: 0.85rem;
  }
  .lang-toggle:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>
