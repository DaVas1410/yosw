---
import { t, type Locale } from '../i18n';
import config from '../data/config.json';
import sponsorsData from '../data/sponsors.json';
import type { Sponsor } from '../data/schemas';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const sponsors = sponsorsData as Sponsor[];

const tiers = ['principal', 'colaborador', 'institucional'] as const;
const groups = tiers.map((tier) => ({
  tier,
  label: t(lang, `sponsors.${tier}`),
  items: sponsors.filter((s) => s.nivel === tier),
}));

const email = config.social.email;
---

<section id="sponsors" class="sponsors">
  <div class="sponsors__inner">
    <h2 class="sponsors__heading">{t(lang, 'sponsors.heading')}</h2>

    <div class="sponsors__tiers">
      {groups.map((group) => (
        <div class="sponsors__tier">
          <h3 class="sponsors__tier-label">{group.label}</h3>
          {group.items.length > 0 ? (
            <div class="sponsors__logos">
              {group.items.map((s) => (
                s.enlace ? (
                  <a class="sponsors__logo" href={s.enlace} target="_blank" rel="noopener noreferrer">
                    {s.logo ? <img src={s.logo} alt={s.nombre} loading="lazy" /> : <span>{s.nombre}</span>}
                  </a>
                ) : (
                  <div class="sponsors__logo">
                    {s.logo ? <img src={s.logo} alt={s.nombre} loading="lazy" /> : <span>{s.nombre}</span>}
                  </div>
                )
              ))}
            </div>
          ) : (
            <div class="sponsors__logos">
              <div class="sponsors__logo sponsors__logo--placeholder" aria-hidden="true"></div>
              <div class="sponsors__logo sponsors__logo--placeholder" aria-hidden="true"></div>
              <div class="sponsors__logo sponsors__logo--placeholder" aria-hidden="true"></div>
            </div>
          )}
        </div>
      ))}
    </div>

    <div class="sponsors__cta">
      {email ? (
        <a class="sponsors__contact" href={`mailto:${email}`}>{t(lang, 'sponsors.cta')}: {email}</a>
      ) : (
        <span class="sponsors__contact sponsors__contact--fallback">{t(lang, 'sponsors.contact.fallback')}</span>
      )}
      <a class="sponsors__download" href="/propuesta-yosw-2026.pdf">{t(lang, 'sponsors.download')}</a>
    </div>
  </div>
</section>

<style>
  .sponsors {
    background: var(--color-bg);
    color: var(--color-text);
    padding: calc(var(--space) * 8) calc(var(--space) * 3);
  }
  .sponsors__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: calc(var(--space) * 4);
  }
  .sponsors__heading {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    margin: 0;
  }
  .sponsors__tiers {
    display: flex;
    flex-direction: column;
    gap: calc(var(--space) * 3);
  }
  .sponsors__tier-label {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-muted);
    margin: 0 0 calc(var(--space)) 0;
  }
  .sponsors__logos {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--space) * 2);
  }
  .sponsors__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface);
    border-radius: var(--radius);
    min-width: 140px;
    min-height: 72px;
    padding: var(--space) calc(var(--space) * 2);
    text-decoration: none;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 0.9rem;
  }
  .sponsors__logo img {
    max-width: 100%;
    max-height: 48px;
  }
  .sponsors__logo--placeholder {
    border: 1px dashed color-mix(in srgb, var(--color-muted) 50%, transparent);
  }
  .sponsors__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(var(--space) * 2);
    padding-top: calc(var(--space) * 2);
    border-top: 1px solid color-mix(in srgb, var(--color-muted) 30%, transparent);
  }
  .sponsors__contact {
    font-family: var(--font-body);
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 600;
  }
  .sponsors__contact:hover {
    text-decoration: underline;
  }
  .sponsors__contact--fallback {
    color: var(--color-muted);
    font-weight: 400;
  }
  .sponsors__download {
    font-family: var(--font-body);
    color: var(--color-text);
    background: var(--color-surface);
    text-decoration: none;
    font-weight: 600;
    padding: calc(var(--space) / 1.2) calc(var(--space) * 2);
    border-radius: var(--radius);
  }
  .sponsors__download:hover {
    filter: brightness(1.15);
  }
</style>
