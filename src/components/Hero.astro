---
import { t, type Locale } from '../i18n';
import Countdown from './Countdown.astro';
import config from '../data/config.json';
import TowerDraw from './TowerDraw.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const fullTitle = t(lang, 'brand.name');
const lastSpace = fullTitle.lastIndexOf(' ');
const titleHead = fullTitle.slice(0, lastSpace);
const titleTail = fullTitle.slice(lastSpace + 1);
---

<section class="hero" id="inicio">
  <div class="wrap hero__grid">
    <div data-reveal>
      <span class="hero__badge"><i></i> {t(lang, 'hero.badge')}</span>
      <h1 class="hero__title">{titleHead} <span class="hero__year">{titleTail}</span></h1>
      <p class="hero__sub">
        {t(lang, 'brand.short')}
        <small>{t(lang, 'hero.dates')}</small>
      </p>
      <div class="hero__meta">
        <span class="chip">
          <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M8 3v4M16 3v4M3 10h18"></path></svg>
          {t(lang, 'hero.dates')}
        </span>
        <span class="chip">
          <svg viewBox="0 0 24 24"><path d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11z"></path><circle cx="12" cy="10" r="2.6"></circle></svg>
          {t(lang, 'hero.venue')}
        </span>
        <span class="chip">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c3 3.6 3 14.4 0 18-3-3.6-3-14.4 0-18z"></path></svg>
          {t(lang, 'hero.modalidad')}
        </span>
      </div>
      <div class="hero__actions">
        <a href="#registro" class="btn btn-primary">{t(lang, 'hero.cta')}</a>
        <a href="#programa" class="btn btn-ghost">{t(lang, 'hero.cta.programa')}</a>
      </div>
      <div class="hero__countdown"><Countdown lang={lang} target={config.eventStart} /></div>
    </div>

    <figure class="hero__visual" data-reveal>
      <div class="hero__tower-card">
        <TowerDraw alt={t(lang, 'hero.tower_alt')} caption={t(lang, 'hero.tower_caption')} />
      </div>
      <span class="hero__float hero__float--1">
        <svg viewBox="0 0 24 24"><circle cx="7" cy="7" r="3"></circle><circle cx="17" cy="17" r="3"></circle><path d="M9 9l6 6"></path></svg>
        {t(lang, 'hero.float.open')}
      </span>
      <span class="hero__float hero__float--2">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"></circle><circle cx="4" cy="18" r="2.4"></circle><circle cx="20" cy="18" r="2.4"></circle><path d="M10 14l-4 3M14 14l4 3"></path></svg>
        {t(lang, 'hero.float.inter')}
      </span>
      <span class="hero__float hero__float--3">
        <svg viewBox="0 0 24 24"><path d="M12 3v18M5 8l7-5 7 5M7 21h10"></path></svg>
        {t(lang, 'hero.float.territorio')}
      </span>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    padding: 8rem 0 3rem;
    overflow: hidden;
    background: var(--color-page);
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--mol-azul) center/420px repeat;
    opacity: 0.55;
    pointer-events: none;
  }
  .hero__grid {
    position: relative;
    width: 100%;
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: 4rem;
    align-items: center;
  }
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.4rem 1rem;
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--y-blue);
    box-shadow: var(--shadow-sm);
  }
  .hero__badge i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--y-green);
    animation: hero-pulse 1.6s infinite;
  }
  @keyframes hero-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(116, 185, 68, 0.5); }
    60% { box-shadow: 0 0 0 8px rgba(116, 185, 68, 0); }
  }
  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 6vw, 4.7rem);
    font-weight: 800;
    color: var(--y-blue);
    letter-spacing: -0.02em;
    margin: 1.1rem 0 0.2rem;
    line-height: 1.02;
  }
  .hero__year {
    color: transparent;
    -webkit-text-stroke: 2.5px var(--y-blue);
  }
  .hero__sub {
    font-size: clamp(1rem, 2vw, 1.3rem);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }
  .hero__sub small {
    display: block;
    font-weight: 600;
    color: var(--color-muted);
    font-size: 0.95rem;
    margin-top: 0.2rem;
  }
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.2rem 0 1.6rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
  .hero__countdown {
    margin-top: 2rem;
  }
  .hero__visual {
    position: relative;
    margin: 0;
  }
  .hero__tower-card {
    position: relative;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 24px;
    box-shadow: var(--shadow-md);
    padding: 2.4rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
    overflow: hidden;
  }
  .hero__tower-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 6px;
    background: var(--grad-spectrum);
  }
  .hero__float {
    position: absolute;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    box-shadow: var(--shadow-sm);
    padding: 0.55rem 0.9rem;
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--y-blue);
    display: flex;
    gap: 0.4rem;
    align-items: center;
    animation: hero-float 5s ease-in-out infinite;
  }
  .hero__float svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }
  .hero__float--1 { top: 8%; left: -6%; }
  .hero__float--2 { bottom: 12%; right: -5%; animation-delay: 1.4s; color: var(--y-teal); }
  .hero__float--3 { top: 46%; right: -9%; animation-delay: 2.6s; color: var(--y-orange); }
  @keyframes hero-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  @media (max-width: 920px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__visual { max-width: 420px; margin-inline: auto; }
  }
  @media (max-width: 560px) {
    .hero__countdown :global(.countdown) { flex-wrap: wrap; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__float { animation: none; }
    .hero__badge i { animation: none; }
  }
</style>
