---
import { t, type Locale } from '../i18n';
import Countdown from './Countdown.astro';
import config from '../data/config.json';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<section class="hero">
  <div class="hero__inner">
    <h1 class="hero__title">{t(lang, 'brand.name')}</h1>
    <p class="hero__dates">{t(lang, 'hero.dates')}</p>
    <p class="hero__venue">{t(lang, 'hero.venue')}</p>
    <Countdown lang={lang} target={config.eventStart} />
    <a class="hero__cta" href="#registro">{t(lang, 'hero.cta')}</a>
  </div>
</section>

<style>
  .hero {
    background: var(--color-bg);
    color: var(--color-text);
    padding: calc(var(--space) * 8) calc(var(--space) * 3);
  }
  .hero__inner {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space);
  }
  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    margin: 0;
  }
  .hero__dates,
  .hero__venue {
    font-family: var(--font-body);
    color: var(--color-muted);
    margin: 0;
    font-size: 1.1rem;
  }
  .hero__cta {
    margin-top: calc(var(--space) * 2);
    display: inline-block;
    background: var(--color-accent);
    color: var(--color-text);
    text-decoration: none;
    font-family: var(--font-body);
    font-weight: 600;
    padding: var(--space) calc(var(--space) * 3);
    border-radius: var(--radius);
  }
  .hero__cta:hover {
    filter: brightness(1.1);
  }
</style>
