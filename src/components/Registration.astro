---
import { t, type Locale } from '../i18n';
import config from '../data/config.json';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const cards = [
  { key: 'attend', href: config.forms.attend },
  { key: 'poster', href: config.forms.poster },
  { key: 'ideaton', href: config.forms.ideaton },
] as const;
---

<section id="registro" class="registro">
  <div class="registro__inner">
    <h2 class="registro__heading">{t(lang, 'reg.heading')}</h2>
    <div class="registro__grid">
      {cards.map((card) => (
        <article class="registro__card">
          <h3 class="registro__card-title">{t(lang, `reg.${card.key}`)}</h3>
          <p class="registro__card-desc">{t(lang, `reg.${card.key}.desc`)}</p>
          {card.href ? (
            <a class="registro__card-cta" href={card.href} target="_blank" rel="noopener noreferrer">
              {t(lang, 'reg.cta.open')}
            </a>
          ) : (
            <span class="registro__card-cta registro__card-cta--disabled" aria-disabled="true">
              {t(lang, 'stats.soon')}
            </span>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .registro {
    background: var(--color-bg);
    color: var(--color-text);
    padding: calc(var(--space) * 8) calc(var(--space) * 3);
  }
  .registro__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: calc(var(--space) * 3);
  }
  .registro__heading {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    margin: 0;
  }
  .registro__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: calc(var(--space) * 2);
  }
  .registro__card {
    background: var(--color-surface);
    border-radius: var(--radius);
    padding: calc(var(--space) * 2);
    display: flex;
    flex-direction: column;
    gap: calc(var(--space));
  }
  .registro__card-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0;
  }
  .registro__card-desc {
    font-family: var(--font-body);
    color: var(--color-muted);
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    flex-grow: 1;
  }
  .registro__card-cta {
    align-self: flex-start;
    display: inline-block;
    background: var(--color-accent);
    color: var(--color-text);
    text-decoration: none;
    font-family: var(--font-body);
    font-weight: 600;
    padding: calc(var(--space) / 1.2) calc(var(--space) * 2);
    border-radius: var(--radius);
  }
  .registro__card-cta:hover {
    filter: brightness(1.1);
  }
  .registro__card-cta--disabled {
    background: var(--color-muted);
    color: var(--color-bg);
    cursor: not-allowed;
    pointer-events: none;
    opacity: 0.7;
  }
</style>
