---
import { t, type Locale } from '../i18n';
import calendario from '../data/calendario.json';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const totalActividades = calendario.dias.reduce(
  (sum, dia) => sum + dia.eventos.length,
  0
);

const stats = [
  { value: 5, label: t(lang, 'about.stat.ejes'), color: 'var(--y-blue)' },
  { value: 6, label: t(lang, 'about.stat.dias'), color: 'var(--y-teal)' },
  { value: totalActividades, label: t(lang, 'about.stat.actividades'), color: 'var(--y-purple)' },
];
---

<section id="about" class="section about">
  <div class="section__wrap">
    <div class="section__head" data-reveal>
      <span class="eyebrow">Yachay Open Science Week</span>
      <h2 class="section__title">{t(lang, 'nav.about')}</h2>
      <div class="divider"></div>
    </div>
    <div class="about__text" data-reveal>
      <p class="section__lead">{t(lang, 'about.intro')}</p>
      <p class="section__lead">{t(lang, 'about.objective')}</p>
    </div>
    <div class="about__stats">
      {stats.map((stat, i) => (
        <div
          class="card card--accent about__stat"
          style={`--accent: ${stat.color}; --delay: ${i * 120}ms`}
          data-reveal
        >
          <span class="about__stat-value" data-countup={stat.value} style={`color: ${stat.color}`}>0</span>
          <span class="about__stat-label">{stat.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .about__text {
    max-width: 760px;
    margin: 0 auto clamp(2rem, 5vh, 3.5rem);
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .about__text .section__lead { margin-inline: auto; }
  .about__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: calc(var(--space) * 2.5);
    max-width: 820px;
    margin: 0 auto;
  }
  .about__stat {
    transition-delay: var(--delay);
    padding: clamp(1.5rem, 4vw, 2.25rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    text-align: center;
  }
  .about__stat-value {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 3.4rem);
    font-weight: 700;
    line-height: 1;
  }
  .about__stat-label {
    font-family: var(--font-body);
    color: var(--color-muted);
    font-size: 0.95rem;
  }
  @media (max-width: 640px) {
    .about__stats { grid-template-columns: 1fr; max-width: 340px; }
  }
</style>

<script>
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      const el = e.target as HTMLElement;
      const end = Number(el.dataset.countup) || 0;
      const dur = 1100;
      const start = performance.now();
      const step = (now: number) => {
        const p = Math.min(1, (now - start) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = String(Math.round(end * eased));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
      io.unobserve(el);
    }
  }, { threshold: 0.5 });
  document.querySelectorAll('[data-countup]').forEach((el) => io.observe(el));
</script>
