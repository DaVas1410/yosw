---
import { t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const otherLang: Locale = lang === 'es' ? 'en' : 'es';

const currentPath = Astro.url.pathname;
const langTogglePath = currentPath.replace(/^\/(es|en)/, `/${otherLang}`);

const links = [
  { href: '#about', label: t(lang, 'nav.about') },
  { href: '#ejes', label: t(lang, 'nav.ejes') },
  { href: '#programa', label: t(lang, 'nav.programa') },
  { href: '#datos', label: t(lang, 'nav.datos') },
  { href: '#participantes', label: t(lang, 'nav.participantes') },
  { href: '#sponsors', label: t(lang, 'nav.sponsors') },
  { href: '#registro', label: t(lang, 'nav.registro') },
];
---

<header class="nav">
  <nav class="nav__bar">
    <a class="nav__logo" href={`/${lang}`} aria-label="YOSW 2026">
      <img src="/src/assets/brand/logo.svg" alt="YOSW 2026" width="160" height="24" />
    </a>
    <ul class="nav__links">
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
    <a class="nav__lang-toggle" href={langTogglePath}>{otherLang.toUpperCase()}</a>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-surface);
    border-bottom: 1px solid color-mix(in srgb, var(--color-muted) 30%, transparent);
  }
  .nav__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--space) * 2);
    padding: var(--space) calc(var(--space) * 3);
    max-width: 1200px;
    margin: 0 auto;
  }
  .nav__logo img {
    display: block;
    color: var(--color-text);
  }
  .nav__links {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--space) * 2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__links a {
    font-family: var(--font-body);
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.9rem;
  }
  .nav__links a:hover {
    color: var(--color-accent);
  }
  .nav__lang-toggle {
    font-family: var(--font-body);
    color: var(--color-text);
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--color-muted) 40%, transparent);
    border-radius: var(--radius);
    padding: calc(var(--space) / 2) var(--space);
    font-size: 0.85rem;
  }
  .nav__lang-toggle:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>
