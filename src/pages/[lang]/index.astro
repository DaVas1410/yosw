---
import { LOCALES, type Locale, t } from '../../i18n';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import Marquee from '../../components/Marquee.astro';
import Cifras from '../../components/Cifras.astro';
import About from '../../components/About.astro';
import EjesSection from '../../components/EjesSection.astro';
import Ideathon from '../../components/Ideathon.astro';
import ProgramTimeline from '../../components/timeline/ProgramTimeline.astro';
import DataSection from '../../components/data/DataSection.astro';
import ParticipantsPreview from '../../components/participants/ParticipantsPreview.astro';
import Registration from '../../components/Registration.astro';
import Sponsors from '../../components/Sponsors.astro';
import Sede from '../../components/Sede.astro';
import Faq from '../../components/Faq.astro';
import Footer from '../../components/Footer.astro';
export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
---
<Base lang={lang} title="Yachay Open Science Week 2026">
  <Nav lang={lang} />
  <Hero lang={lang} />
  <Marquee lang={lang} />
  <Cifras lang={lang} />
  <About lang={lang} />
  <EjesSection lang={lang} />
  <Ideathon lang={lang} />
  <ProgramTimeline lang={lang} />
  <DataSection lang={lang} />
  <ParticipantsPreview lang={lang} />
  <Registration lang={lang} />
  <Sponsors lang={lang} />
  <Sede lang={lang} />
  <Faq lang={lang} />
  <Footer lang={lang} />
</Base>
